{
  "manifest_version": 3,
  "name": "슬리더링크 패턴 힌트",
  "version": "0.2.0",
  "description": "puzzle-loop.com 도우미. 패턴 자리 표시, 힌트, 실수 표시, 풀이 중 도움 단계를 고른다.",
  "icons": { "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["*://*.puzzle-loop.com/*", "*://puzzle-loop.com/*"],
      "js": ["engine.js", "content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "loop-hint@ysw.kr", "strict_min_version": "128.0" }
  }
}
